# ==================================================
# Configuration Apache (hébergement mutualisé : OVH, o2switch, Hostinger…)
# Même comportement que vercel.json : URL propres sans .html ni / final, page 404, en-têtes, cache.
# Ignoré par Vercel, qui lit vercel.json.
# ==================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType text/javascript .js .mjs
</IfModule>

# ---------- fichiers de travail jamais servis ----------
<FilesMatch "^(CLAUDE\.md|README\.md|server\.mjs|package(-lock)?\.json|vercel\.json|\.gitignore|\.vercelignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # dossiers cachés (.git, .claude…) : introuvables
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

    # HTTPS, et adresse sans www (celle des balises canonical)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://clementlequeurre.com%{REQUEST_URI} [R=301,L,NE]

    # /page.html → /page, /index.html → /
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # pas de / final (sauf vrais dossiers)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # /page → sert page.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------- en-têtes de sécurité ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---------- cache : 30 jours pour les médias, 1 h pour CSS / JS, rien pour les pages ----------
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|mp3|ogg|wav|pdf|woff2?)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ---------- compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
